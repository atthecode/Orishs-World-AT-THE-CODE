# AT THE CODE Open Voice — V1.28 development configuration
ORISH_VOICE_HOST=127.0.0.1
ORISH_VOICE_PORT=8787
ORISH_VOICE_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Local whisper.cpp executable + local model file. Never commit model weights.
ORISH_WHISPER_CPP_BIN=/absolute/path/to/whisper-cli
ORISH_WHISPER_MODEL=/absolute/path/to/ggml-base.en.bin
ORISH_FFMPEG_BIN=ffmpeg

# Optional local Kokoro adapter. Use the Python interpreter where Kokoro is installed.
ORISH_TTS_PYTHON=/absolute/path/to/voice-gateway/.runtime/venv/bin/python
ORISH_TTS_ADAPTER=/absolute/path/to/voice-gateway/adapters/kokoro_tts.py
ORISH_KOKORO_LANG=a
ORISH_KOKORO_VOICE=af_heart
ORISH_KOKORO_SPEED=1.0

# Reserved for a future reviewed local LLM service.
# V1.28 child replies still DO NOT use this directly; the approved Orish router remains in control.
ORISH_LOCAL_LLM_URL=http://127.0.0.1:8081
